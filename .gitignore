# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/
out-tsc/
bazel-out/

# Angular cache & temporary files
.angular/
**/.angular/
tmp/
**/tmp/

# Logs
*.log
**/*.log
server_log.txt
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (protect database credentials)
.env
**/.env
!.env.example
!**/.env.example

# OS generated files
.DS_Store
Thumbs.db
ehthumbs.db

# IDE and editor files
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.sublime-workspace
*.swp
